# syntax=docker/dockerfile:1.7
#
# Transparent Stage-0 publisher for the source-local development toolchain
# payload. No package manager runs here and no file from the publisher image is
# copied into the result. The signed input contract selects every upstream
# byte. Runtime loader/library authority is a separate realization gate.

FROM --platform=linux/amd64 docker.io/library/rust@sha256:443dd9a3260cf23c22fc05051dd5661dd7b4028d3d25dbaffab6563b63c3539c AS stage0-platform-publisher

WORKDIR /publisher
ENV RYEOS_STAGE0_PUBLISHER_IMAGE=docker.io/library/rust@sha256:443dd9a3260cf23c22fc05051dd5661dd7b4028d3d25dbaffab6563b63c3539c
COPY .ai/config/development/ryeos/stage0-platform-x86_64-linux.yaml /publisher/inputs.yaml
COPY scripts/release/produce-development-toolchain-stage0.sh /publisher/produce.sh

RUN --mount=type=cache,id=ryeos-development-stage0-downloads,target=/publisher/downloads,sharing=locked \
    mkdir /publisher/out && \
    /publisher/produce.sh \
      --inputs /publisher/inputs.yaml \
      --cache /publisher/downloads \
      --output /publisher/out/ryeos-development-toolchain-stage0-rust-1.95.0-zig-0.15.2-x86_64-unknown-linux-gnu.tar.gz

FROM scratch AS development-toolchain-stage0-artifact
COPY --from=stage0-platform-publisher /publisher/out/ /
